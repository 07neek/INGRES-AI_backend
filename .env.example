# Copy this file to .env and fill in real values before running in earnest.
# Everything here already has a working sample/default so the backend runs
# immediately in "reference dataset + offline reply" mode with zero setup —
# see README.md "Run modes" for what that means.

# ── App ─────────────────────────────────────────────────────────────────
APP_NAME=INGRES-AI Backend
APP_ENV=development

# ── AI model (Groq — OpenAI-compatible Chat Completions API) ───────────
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=paste your api key go to the groq.com and create api key and paste it
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Checked live (July 2026): llama-3.1-8b-instant / llama-3.3-70b-versatile
# are deprecated (shutdown 2026-08-16). Using the current recommended model.
# Swap to "openai/gpt-oss-120b" for higher quality / slower, or point these
# three vars at any other OpenAI-compatible provider (OpenAI, OpenRouter,
# Together AI, a local Ollama server, etc.) — nothing else needs to change.
GROQ_MODEL=openai/gpt-oss-20b
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=700
LLM_TIMEOUT_SECONDS=30

# ── National Water Data Portal (data.gov.in-style resource API) ────────
# WATER_DATA_API_KEY below is data.gov.in's own PUBLICLY PUBLISHED sample
# key (shown in their official API client docs for trying endpoints before
# you register) — it is NOT a private secret, treat it only as a placeholder.
# Get your own free key: register at https://data.gov.in -> My Account -> API Key
# (or https://indiawris.gov.in for India-WRIS access).
WATER_DATA_API_KEY=579b464db66ec23bdd000001cdd3946e44ce4aad7209ff7b23ac571b
WATER_DATA_BASE_URL=https://api.data.gov.in/resource
# Placeholder — replace with the real resource UUID of the CGWB dataset you
# register (e.g. from https://data.gov.in/catalogs or indiawris.gov.in).
WATER_DATA_RESOURCE_ID=REPLACE_WITH_REAL_RESOURCE_ID
WATER_DATA_TIMEOUT_SECONDS=15
# Keep false until WATER_DATA_RESOURCE_ID above is a real, verified ID —
# false means "use the bundled reference dataset" (see app/data), which is
# realistic sample data modeled on real CGWB categories, good enough to
# demo the whole pipeline end-to-end today.
USE_LIVE_WATER_API=false

# ── CORS — origins allowed to call this API from a browser ─────────────
# Add your frontend's dev AND deployed URLs, comma-separated, no spaces.
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# ── Conversation memory (in-process, no database) ───────────────────────
MAX_HISTORY_TURNS=6
SESSION_TTL_MINUTES=60
